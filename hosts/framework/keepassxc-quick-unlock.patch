+/**
+ * Quick Unlock (the fingerprint prompt) without showing this dialog. The
+ * prompt blocks until answered; on success the dialog completes without ever
+ * appearing. Returns whether the target database is now unlocked.
+ */
+bool DatabaseOpenDialog::quickUnlockWithoutWindow()
+{
+    if (!m_view || !m_currentDbWidget || !m_view->canPerformQuickUnlock()) {
+        return false;
+    }
+    m_view->toggleQuickUnlockScreen();
+    if (!m_view->isOnQuickUnlockScreen() || m_view->unlockingDatabase()) {
+        return false;
+    }
+    m_view->triggerQuickUnlock();
+    if (m_currentDbWidget && !m_currentDbWidget->isLocked()) {
+        return true;
+    }
+    m_skipQuickUnlockOnShow = true;
+    return false;
+}
