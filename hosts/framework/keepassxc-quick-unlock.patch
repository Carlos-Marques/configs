+/**
+ * Quick Unlock (the fingerprint prompt) while the window stays hidden.
+ * Returns whether the database is now unlocked.
+ */
+bool DatabaseWidget::quickUnlockWithoutWindow()
+{
+    if (!isLocked() || !m_databaseOpenWidget || !m_databaseOpenWidget->canPerformQuickUnlock()) {
+        return false;
+    }
+    m_databaseOpenWidget->toggleQuickUnlockScreen();
+    if (!m_databaseOpenWidget->isOnQuickUnlockScreen() || m_databaseOpenWidget->unlockingDatabase()) {
+        return false;
+    }
+    m_databaseOpenWidget->triggerQuickUnlock();
+    return !isLocked();
+}
