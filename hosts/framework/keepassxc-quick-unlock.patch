+/**
+ * Quick Unlock (the fingerprint prompt) while the window stays hidden. The
+ * prompt blocks until answered. Returns whether the database is now unlocked;
+ * if not, the next show of the unlock screen won't ask for it again.
+ */
+bool DatabaseWidget::quickUnlockWithoutWindow()
+{
+    if (!isLocked() || !m_databaseOpenWidget || !m_databaseOpenWidget->canPerformQuickUnlock()) {
+        return false;
+    }
+    m_databaseOpenWidget->toggleQuickUnlockScreen();
+    if (!m_databaseOpenWidget->isOnQuickUnlockScreen() || m_databaseOpenWidget->unlockingDatabase()) {
+        return false;
+    }
+    m_databaseOpenWidget->triggerQuickUnlock();
+    if (!isLocked()) {
+        return true;
+    }
+    m_databaseOpenWidget->skipAutoQuickUnlockOnce();
+    return false;
+}
